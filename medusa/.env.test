# Test environment config — separate database from dev/prod so integration
# tests never touch real data. Same Postgres instance, distinct DB name
# (simplest correct setup for a single-VPS/local-dev project; a fully
# separate Postgres instance would be overkill here).
#
# `npm run test:integration:http` / `test:integration:modules` / `test:unit`
# all load this file via jest.config.js's `loadEnv("test", ...)`.
DATABASE_URL=postgres://medusa:medusa_test_password@localhost:5432/medusa_test
REDIS_URL=redis://localhost:6379

# @medusajs/test-utils' medusaIntegrationTestRunner does NOT use DATABASE_URL
# for its own database lifecycle — it auto-generates and manages its own
# template/temp databases per test file via these separate DB_* vars
# (see @medusajs/test-utils/dist/database.js), defaulting to an empty
# username/password if unset, which fails auth against a real Postgres user.
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=medusa
DB_PASSWORD=medusa_test_password

JWT_SECRET=test-jwt-secret-not-for-production-use
COOKIE_SECRET=test-cookie-secret-not-for-production-use

STORE_CORS=http://localhost:3000,http://localhost:8000
ADMIN_CORS=http://localhost:9000,http://localhost:5173
AUTH_CORS=http://localhost:3000,http://localhost:9000

MEDUSA_WORKER_MODE=shared
DISABLE_MEDUSA_ADMIN=true
