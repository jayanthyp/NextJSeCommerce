# @medusajs/types declares a peerOptional dependency on vite@^5.4.21, which
# in turn peerOptionally wants @types/node@^18||>=20 — conflicting with this
# project's pinned @types/node@17.0.21 (kept for compatibility with other
# parts of the toolchain). Vite/Vitest are dev-only test tooling here, never
# part of the actual Next.js runtime, so the conflict is inert in practice;
# without this, `npm ci` fails outright in any clean environment (CI, a
# fresh Docker build) even though `npm install` locally papers over it.
legacy-peer-deps=true
