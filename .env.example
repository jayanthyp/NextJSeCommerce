# =============================================================================
#  NextJSeCommerce — single-VPS environment
#  Copy to .env (scripts/bootstrap.sh does this for you and fills the CHANGEME_*
#  tokens with `openssl rand -hex` values). Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Domains / TLS
#   Apex + www  -> storefront (www 301-redirects to apex)
#   api.<apex>  -> Medusa backend + Admin at /app
#   All three A records must already point at this VPS before `up`, or Caddy's
#   HTTP-01 challenge will fail.
# -----------------------------------------------------------------------------
STORE_DOMAIN=example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# Leave EMPTY for real, publicly-trusted certificates (the production setting).
# Set to the literal string `local_certs` while testing against an IP or an
# un-pointed domain: Caddy then issues self-signed certs from its internal CA
# instead of burning Let's Encrypt's duplicate-certificate quota (5 per week).
CADDY_LOCAL_CERTS=

# -----------------------------------------------------------------------------
# PostgreSQL  (never published to the host — reachable only on the Docker network)
#   DATABASE_URL is NOT set here: docker-compose.yml composes it from these three
#   values, so the password lives in exactly one place.
# -----------------------------------------------------------------------------
POSTGRES_USER=medusa
POSTGRES_PASSWORD=CHANGEME_POSTGRES_PASSWORD
POSTGRES_DB=medusa

# -----------------------------------------------------------------------------
# Redis — cache + event bus + workflow engine
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# MeiliSearch — product search index (never published to the host)
# -----------------------------------------------------------------------------
MEILI_MASTER_KEY=CHANGEME_MEILI_MASTER_KEY

# -----------------------------------------------------------------------------
# Medusa backend
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGEME_JWT_SECRET
COOKIE_SECRET=CHANGEME_COOKIE_SECRET

# "shared" = one process serves the API, the Admin and background jobs.
# Correct choice on a 4GB box; "server"/"worker" would need a second container.
MEDUSA_WORKER_MODE=shared

# Public origin of the backend. Baked into Admin asset URLs and into the URLs
# stored for uploaded product images — must be the public URL, not backend:9000.
MEDUSA_BACKEND_URL=https://api.example.com

# CORS allowlists (comma-separated, no trailing slash).
STORE_CORS=https://example.com,https://www.example.com
ADMIN_CORS=https://api.example.com
AUTH_CORS=https://example.com,https://www.example.com,https://api.example.com

# -----------------------------------------------------------------------------
# Email — Gmail SMTP via the custom nodemailer notification provider
#   SMTP_PASS must be a 16-character Google App Password (Google account ->
#   Security -> 2-Step Verification -> App passwords). Your normal account
#   password will NOT work; Google disabled that in 2022.
#   Limits: ~500 recipients/day, and Google rewrites From to SMTP_USER.
#   Leave SMTP_USER empty to disable email entirely (events log instead).
#
#   For local testing without real Gmail credentials or risking a real send,
#   point this at the Mailpit service in docker-compose.local.yml instead:
#   SMTP_HOST=mailpit, SMTP_PORT=1025, SMTP_SECURE=false, SMTP_USER/PASS can
#   be any non-empty placeholder. View "sent" mail at http://localhost:8025.
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Example Store <you@gmail.com>"

# -----------------------------------------------------------------------------
# Google sign-in — optional. Create an OAuth 2.0 Client ID (Google Cloud
# Console -> APIs & Services -> Credentials -> Web application) with an
# authorized redirect URI of https://<STORE_DOMAIN>/auth/callback/google
# (deliberately outside any locale-prefixed path — Google requires one fixed,
# exactly-matching URI). Leave GOOGLE_CLIENT_ID empty to disable the
# provider entirely (storefront falls back to email/password only).
#
# In production this is synced automatically from the GOOGLE_CLIENT_ID /
# GOOGLE_CLIENT_SECRET GitHub Actions repo secrets on every deploy (see
# .github/workflows/deploy-vps.yml's deploy job) — set them there rather
# than editing the VPS's .env by hand. Leaving a secret unset there leaves
# whatever's already in the VPS's .env untouched, it doesn't blank it out.
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -----------------------------------------------------------------------------
# Razorpay payment gateway — optional (see issue #7). Leave RAZORPAY_KEY_ID
# empty to disable it entirely; checkout falls back to Medusa's built-in
# "system" (manual/mark-as-paid) provider, which is always available
# regardless of this config.
#
# Use Razorpay's TEST MODE key/secret here for local dev (Dashboard ->
# Settings -> API Keys) — never live keys in a local .env. The webhook
# secret is set separately when configuring the webhook URL (Dashboard ->
# Settings -> Webhooks), not the same value as the key secret.
#
# Do not paste real credentials into a GitHub issue or commit message — add
# them here (local) or as GitHub Actions repo secrets (production), the same
# way GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET above are handled.
# -----------------------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# MailerLite — optional newsletter sync for the checkout marketing-consent
# checkbox. Leave MAILERLITE_API_KEY empty to skip syncing (the consent
# record still persists locally either way). MAILERLITE_GROUP_ID is optional;
# omit it to add subscribers without assigning a group.
#
# MAILERLITE_API_KEY is synced the same way as the Google credentials above
# (GitHub Actions repo secret, applied on deploy). MAILERLITE_GROUP_ID is
# not — it's not sensitive, so it's still set by hand in the VPS's .env.
# -----------------------------------------------------------------------------
MAILERLITE_API_KEY=
MAILERLITE_GROUP_ID=

# -----------------------------------------------------------------------------
# Next.js storefront
#   NEXT_PUBLIC_* values are INLINED INTO THE JS BUNDLE AT BUILD TIME.
#   Changing any of them requires `docker compose build --no-cache storefront`,
#   not just a restart.
# -----------------------------------------------------------------------------

# Browser-side backend URL (must be publicly routable).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.example.com

# Server-side backend URL. Server Components and Server Actions run inside the
# Docker network, so they talk to Medusa over internal DNS and skip Caddy/TLS.
MEDUSA_BACKEND_URL_INTERNAL=http://backend:9000

NEXT_PUBLIC_BASE_URL=https://example.com

# Must be a country code actually present in a seeded region, or the
# storefront's middleware silently falls back to whatever region comes first.
# The official Medusa seed script creates one "Europe" region covering
# de/dk/es/fr/gb/it/se — no "us" — so "dk" is correct here, not "us". Confirm
# after seeding with:
#   curl -H "x-publishable-api-key: $KEY" $API_DOMAIN/store/regions
NEXT_PUBLIC_DEFAULT_REGION=dk

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Optional — leave
# empty to disable analytics entirely; the Analytics component no-ops when
# unset. Create the GA4 property in Google Analytics first.
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# MeiliSearch — react-instantsearch queries this DIRECTLY from the browser,
# so it must be the public Caddy-proxied endpoint (api.<domain>/search), not
# the internal meilisearch:7700 address. NEXT_PUBLIC_SEARCH_API_KEY must be
# the search-ONLY scoped key, never MEILI_MASTER_KEY — MeiliSearch
# auto-generates a "Default Search API Key" the first time it boots with a
# master key set; fetch it once with:
#   curl -H "Authorization: Bearer $MEILI_MASTER_KEY" http://localhost:7700/keys
# (run from the backend container, or via an SSH tunnel) and copy the key
# whose description says "Default Search API Key" — not the Admin one.
NEXT_PUBLIC_SEARCH_ENDPOINT=https://api.example.com/search
NEXT_PUBLIC_SEARCH_API_KEY=
NEXT_PUBLIC_SEARCH_INDEX_NAME=products

# Shows/hides the "Continue with Google" button — must match whether
# GOOGLE_CLIENT_ID is actually set above (this is a separate build-time flag,
# not derived automatically, since the storefront build can't see the
# backend's env). "true" or empty/anything else (hidden).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Created by the seed script / Admin -> Settings -> Publishable API Keys.
# Empty on first bootstrap; filled in before the storefront is built (step 5).
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Guards the storefront's on-demand revalidation route.
REVALIDATE_SECRET=CHANGEME_REVALIDATE_SECRET
