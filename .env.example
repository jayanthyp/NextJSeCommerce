# =============================================================================
#  NextJSeCommerce — single-VPS environment
#  Copy to .env (scripts/bootstrap.sh does this for you and fills the CHANGEME_*
#  tokens with `openssl rand -hex` values). Never commit .env.
# =============================================================================

# -----------------------------------------------------------------------------
# Domains / TLS
#   Apex + www  -> storefront (www 301-redirects to apex)
#   api.<apex>  -> Medusa backend + Admin at /app
#   All three A records must already point at this VPS before `up`, or Caddy's
#   HTTP-01 challenge will fail.
# -----------------------------------------------------------------------------
STORE_DOMAIN=example.com
API_DOMAIN=api.example.com
ACME_EMAIL=you@example.com

# Leave EMPTY for real, publicly-trusted certificates (the production setting).
# Set to the literal string `local_certs` while testing against an IP or an
# un-pointed domain: Caddy then issues self-signed certs from its internal CA
# instead of burning Let's Encrypt's duplicate-certificate quota (5 per week).
CADDY_LOCAL_CERTS=

# -----------------------------------------------------------------------------
# PostgreSQL  (never published to the host — reachable only on the Docker network)
#   DATABASE_URL is NOT set here: docker-compose.yml composes it from these three
#   values, so the password lives in exactly one place.
# -----------------------------------------------------------------------------
POSTGRES_USER=medusa
POSTGRES_PASSWORD=CHANGEME_POSTGRES_PASSWORD
POSTGRES_DB=medusa

# -----------------------------------------------------------------------------
# Redis — cache + event bus + workflow engine
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379

# -----------------------------------------------------------------------------
# Medusa backend
# -----------------------------------------------------------------------------
JWT_SECRET=CHANGEME_JWT_SECRET
COOKIE_SECRET=CHANGEME_COOKIE_SECRET

# "shared" = one process serves the API, the Admin and background jobs.
# Correct choice on a 4GB box; "server"/"worker" would need a second container.
MEDUSA_WORKER_MODE=shared

# Public origin of the backend. Baked into Admin asset URLs and into the URLs
# stored for uploaded product images — must be the public URL, not backend:9000.
MEDUSA_BACKEND_URL=https://api.example.com

# CORS allowlists (comma-separated, no trailing slash).
STORE_CORS=https://example.com,https://www.example.com
ADMIN_CORS=https://api.example.com
AUTH_CORS=https://example.com,https://www.example.com,https://api.example.com

# -----------------------------------------------------------------------------
# Email — Gmail SMTP via the custom nodemailer notification provider
#   SMTP_PASS must be a 16-character Google App Password (Google account ->
#   Security -> 2-Step Verification -> App passwords). Your normal account
#   password will NOT work; Google disabled that in 2022.
#   Limits: ~500 recipients/day, and Google rewrites From to SMTP_USER.
#   Leave SMTP_USER empty to disable email entirely (events log instead).
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Example Store <you@gmail.com>"

# -----------------------------------------------------------------------------
# Next.js storefront
#   NEXT_PUBLIC_* values are INLINED INTO THE JS BUNDLE AT BUILD TIME.
#   Changing any of them requires `docker compose build --no-cache storefront`,
#   not just a restart.
# -----------------------------------------------------------------------------

# Browser-side backend URL (must be publicly routable).
NEXT_PUBLIC_MEDUSA_BACKEND_URL=https://api.example.com

# Server-side backend URL. Server Components and Server Actions run inside the
# Docker network, so they talk to Medusa over internal DNS and skip Caddy/TLS.
MEDUSA_BACKEND_URL_INTERNAL=http://backend:9000

NEXT_PUBLIC_BASE_URL=https://example.com

# Must be a country code actually present in a seeded region, or the
# storefront's middleware silently falls back to whatever region comes first.
# The official Medusa seed script creates one "Europe" region covering
# de/dk/es/fr/gb/it/se — no "us" — so "dk" is correct here, not "us". Confirm
# after seeding with:
#   curl -H "x-publishable-api-key: $KEY" $API_DOMAIN/store/regions
NEXT_PUBLIC_DEFAULT_REGION=dk

# Created by the seed script / Admin -> Settings -> Publishable API Keys.
# Empty on first bootstrap; filled in before the storefront is built (step 5).
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=

# Guards the storefront's on-demand revalidation route.
REVALIDATE_SECRET=CHANGEME_REVALIDATE_SECRET
